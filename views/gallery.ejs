<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Fotogalerii</title>
    <link rel="stylesheet" href="/style/gallery.css">
    <script src="/script/gallery.js" defer></script>
</head>
<body>

    <img src="/pic/veebiprogrammeerimine_2026_AA.png" alt="banner">

    <h1>Fotogalerii</h1>
    <ul>
        <li><a href="/home">Avalehele</a></li>
		<li><a href="/galleryphotoupload"> Fotode üleslaadimine</a></li>
        <li><a href="/logout">Logi välja</a></li>
    </ul>
    <hr>
    <!--Dialoogiaken normaalsuuruses fotode näitamiseks-->
    <dialog id="modal" class="modalarea">
        <span id="modalClose" class="modalclose">&times;</span>
        <div class="modalhorizontal">
            <div class="modalvertical">
                <p id="modalCaption"></p>
                <img id="modalImage" src="../pic/empty.png" alt="galeriipilt">
            </div>
        </div>
    </dialog>
    <% if (photos.length > 0) { %>
        <div id="gallery" class="gallery">
            <% photos.forEach(function(photo) { %>
            
                <img
                    src="/gallery/thumbs/<%= photo.filename %>"
                    alt="<%= photo.alttext || 'Foto' %>"
                    data-id="<%= photo.id %>"
                    data-filename="<%= photo.filename %>"
                    class="thumbs"
                >

            <% }) %>
        </div>
    <% } else { %>

        <p>Fotosid ei leitud.</p>

    <% } %>

</body>
</html>